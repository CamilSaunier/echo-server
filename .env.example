# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=
NODE_ENV=
FRONTEND_URL=
SOCKET_URL=

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
DB_PORT=
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=your_db_name

# URL pour le serveur (interne à Docker)
DATABASE_URL="postgresql://your_db_user:your_db_password@echo-db:5432/your_db_name?schema=public"

# URL pour les scripts de test (exécutés depuis l'hôte)
TEST_DATABASE_URL="postgresql://your_db_user:your_db_password@localhost:5433/your_db_name?schema=public"

# ==========================================
# JWT SECRETS
# ==========================================
JWT_ACCESS_SECRET=your_super_secret_access_key_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_here